# ==============================================================================
# ScamLens-AI Environment Configuration Template
# Copy this file to .env and fill in your keys and local settings.
# Do NOT commit .env containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_ENV=development               # development | staging | production | test
DEBUG=true
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

# ------------------------------------------------------------------------------
# Multimodal AI / LLM Providers
# ------------------------------------------------------------------------------
# Primary multimodal agent provider (custom | groq | gemini | openai | anthropic)
DEFAULT_AI_PROVIDER=custom

# Custom OpenAI-compatible Endpoint (vLLM / Private GPU Server)
CUSTOM_AI_BASE_URL=https://103.42.50.41:1034/v1
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=Qwen/Qwen3-8B
CUSTOM_AI_VISION_MODEL=Qwen/Qwen3-8B
CUSTOM_AI_CA_CERT=assets/vm04-ca.crt

# Groq API (High-speed inference for open-source models: Llama 3.3, Llama 3.2 Vision)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Google Gemini API (Multimodal: Vision + Text)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# OpenAI API (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic API (Optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# Threat Intelligence & External Verification APIs
# ------------------------------------------------------------------------------
# Set to 'true' to use simulated mock intelligence during local offline testing
USE_MOCK_INTELLIGENCE=true

# Google Safe Browsing API v4
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API v3
VIRUSTOTAL_API_KEY=

# WHOIS Lookup API (e.g. WhoisXML API or similar)
WHOISXML_API_KEY=

# ------------------------------------------------------------------------------
# Privacy & Security Guardrails
# ------------------------------------------------------------------------------
# Automatically mask phone numbers, credit card numbers, OTPs, and passwords
ENABLE_PII_REDACTION=true

# Restrict maximum upload sizes (in megabytes)
MAX_IMAGE_UPLOAD_MB=10

# Maximum text length for single submission
MAX_TEXT_INPUT_CHARS=10000

# ------------------------------------------------------------------------------
# Regional & Knowledge Base Settings (Default: India)
# ------------------------------------------------------------------------------
DEFAULT_REGION=IN
ENABLE_REGIONAL_ADVISORIES=true    # Include RBI, TRAI, NPCI & 1930 Cybercrime guidance
DATA_DIR=./data

# ------------------------------------------------------------------------------
# Gmail REST API Integration
# ------------------------------------------------------------------------------
# Path to OAuth2 client secrets JSON file downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json

# Path to cached OAuth2 token file
GMAIL_TOKEN_FILE=token.json

# OAuth scopes (defaults to read-only for least-privilege security)
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

